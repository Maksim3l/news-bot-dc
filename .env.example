# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the first three values. Everything below
# them already has a working default.
# ---------------------------------------------------------------------------

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Default channel for sources that do not name one.
# Discord > User Settings > Advanced > Developer Mode, then right-click a
# channel > Copy Channel ID.
DISCORD_CHANNEL_ID=

# console.anthropic.com > API Keys. Only the daily digest uses it; without it
# the bot still posts feeds live, but /digest and the daily post fail.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your server ID. Set it and slash commands appear instantly instead of taking
# up to an hour to propagate globally.
DISCORD_GUILD_ID=

# Discord Developer Portal > your app > General Information > Application ID.
# Set it and the bot logs a ready-made invite link on startup.
DISCORD_APPLICATION_ID=

# Where the watch list lives. Template: sources.example.yml
SOURCES_FILE=sources.yml

# Daily digest settings. Template: digest.example.yml. Missing file = digest off.
DIGEST_FILE=digest.yml

# Dedupe database. Delete this file to make the bot forget what it has posted.
DATABASE_PATH=data/seen.sqlite3

# Default seconds between polls, per source. sources.yml can override it.
POLL_INTERVAL=600

# Most posts per source per poll. Leftovers arrive on the next poll instead of
# flooding the channel.
MAX_ITEMS_PER_POLL=5

# true posts everything a source already has the first time it is polled.
# Leave false: the first poll only records what exists, then posts what is new.
ANNOUNCE_BACKLOG=false

# Seconds before a slow site is given up on.
HTTP_TIMEOUT=20

# How long a posted item is remembered before it is pruned.
RETENTION_DAYS=90

# Sent with every request. Some sites block the default python agent.
USER_AGENT=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
